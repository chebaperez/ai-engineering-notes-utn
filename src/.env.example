# ==============================================================================
# CONFIGURACIÓN DE CREDENCIALES - CLASE 2 (UTN FRSR)
# ==============================================================================
# Copia este archivo con el nombre '.env' en la raíz del proyecto o en la carpeta src/:
#   cp src/.env.example .env
#
# Obtén tu API Key gratuita de Google Gemini en Google AI Studio:
#   https://aistudio.google.com/ (botón "Get API key")
# ==============================================================================

# Clave de API de Google Gemini (requerida para invocar modelos cloud)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo por defecto a utilizar a través de LiteLLM
# Modelos disponibles en el Free Tier de Google AI Studio:
#   - gemini/gemini-3.8-flash      (Recomendado: rápido, potente y con cuota gratuita)
#   - gemini/gemini-3.5-flash-lite (Ultra rápido para tareas masivas de baja complejidad)
#   - gemini/gemini-3.6-flash      (Variante balanceada con cuota gratuita)
DEFAULT_MODEL=gemini/gemini-3.8-flash
