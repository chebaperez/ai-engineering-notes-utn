# ==============================================================================
# CONFIGURACIÓN DE CREDENCIALES - CLASE 2 (UTN FRSR)
# ==============================================================================
# Copia este archivo con el nombre '.env' en la raíz del proyecto o en la carpeta src/:
#   cp src/.env.example .env
#
# Puedes configurar una clave de Google Gemini (gratuita en https://aistudio.google.com/)
# o una clave de OpenAI (https://platform.openai.com/api-keys).
# ==============================================================================

# Clave de API de Google Gemini
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Clave de API de OpenAI (opcional, alternativa a Gemini)
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# Modelo por defecto a utilizar a través de LiteLLM (opcional).
# Si se omite, el script elegirá automáticamente según la API Key activa:
#   - Con GEMINI_API_KEY: gemini/gemini-3.8-flash (o gemini/gemini-3.5-flash-lite, gemini/gemini-3.6-flash)
#   - Con OPENAI_API_KEY: openai/gpt-4o-mini (o openai/gpt-4o)
# DEFAULT_MODEL=gemini/gemini-3.8-flash
